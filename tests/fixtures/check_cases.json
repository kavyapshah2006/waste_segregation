{
  "_doc": "Unit cases for the answer checker and off-topic guard, shared by the Python tests (tests/test_check_cases.py) and the Kotlin tests (android/core). Each case may carry a 'why' note. Item-based cases resolve the item with the given attributes and language in the default city.",
  "extract_json": [
    {
      "text": "{\"a\": 1}",
      "expected": {
        "a": 1
      }
    },
    {
      "text": "noise {\"a\": \"}\"} more",
      "expected": {
        "a": "}"
      }
    },
    {
      "text": "{\"a\": \"say \\\"hi\\\" {x}\"}",
      "expected": {
        "a": "say \"hi\" {x}"
      }
    },
    {
      "text": "[1, 2] then {\"b\": 2}",
      "expected": {
        "b": 2
      }
    },
    {
      "text": "{broken} {\"c\": 3}",
      "expected": {
        "c": 3
      }
    },
    {
      "text": "{\"a\": 1",
      "expected": {
        "a": 1
      },
      "why": "missing final brace is repaired"
    },
    {
      "text": "{\"a\": \"x\", \"b\": \"y\"<|eot_id|>",
      "expected": {
        "a": "x",
        "b": "y"
      }
    },
    {
      "text": "{\"a\": \"cut off mid-sen",
      "expected": null,
      "why": "never repaired: would show a cut-off sentence"
    },
    {
      "text": "{\"a\": {\"b\": 1}",
      "expected": {
        "a": {
          "b": 1
        }
      }
    },
    {
      "text": "{\"a\": 1,",
      "expected": null
    },
    {
      "text": "no json here",
      "expected": null
    },
    {
      "text": "",
      "expected": null
    },
    {
      "text": "{\"a\": \"line\nbreak\"}",
      "expected": null,
      "why": "raw control character inside a string is invalid JSON (Python strict mode)"
    },
    {
      "text": "{\"a\": 1, \"a\": 2}",
      "expected": {
        "a": 2
      },
      "why": "duplicate key: last wins"
    },
    {
      "text": "{\"a\": \"\\u0928\\u0940\"}",
      "expected": {
        "a": "नी"
      }
    },
    {
      "text": "{\"a\": 01}",
      "expected": null,
      "why": "leading zero is invalid"
    },
    {
      "text": "{\"a\": [1, 2,]}",
      "expected": null,
      "why": "trailing comma is invalid"
    }
  ],
